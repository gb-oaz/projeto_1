<?xml version="1.0" encoding="utf-8"?>
<!--
  Cobertura dos testes de ms_mono/ (RNF-25). O core/commons tem o projeto de
  testes dele (tests/core/commons/); medido aqui também, entraria com as linhas
  que estes testes não exercitam e baixaria a soma do CI.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Exclude>[Boaz.Core.Commons]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
