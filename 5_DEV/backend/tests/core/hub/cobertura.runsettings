<?xml version="1.0" encoding="utf-8"?>
<!--
  Cobertura dos testes de core/hub/ (RNF-25): só o Boaz.Core.Hub. O
  core/commons tem o projeto de testes dele; medido aqui também, entraria com
  as linhas que estes testes não exercitam e baixaria a soma do CI.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Exclude>[Boaz.Core.Commons]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
