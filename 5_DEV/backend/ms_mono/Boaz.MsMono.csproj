<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    ms_mono: runtime do backend, gera a imagem backend-mono (RNF-177).
    Adaptadores em infra/in/<contexto>/<feature>/ (endpoints HTTP) e
    infra/out/<contexto>/<feature>/ (MongoDB e Redis); o Program.cs é o ponto
    de composição que liga as portas do core aos adaptadores (RN-149).
  -->
  <ItemGroup>
    <!-- Documentação da API em /doc/api (sistema/DocumentacaoApi.cs) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adaptadores de saída (infra/out): banco e cache, nas versões do qa -->
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.29" />
  </ItemGroup>

  <!--
    Os textos da documentação de cada endpoint vêm dos comentários XML das ações
    dos controllers, lidos pelo gerador do Microsoft.AspNetCore.OpenApi
    (sistema/DocumentacaoApi.cs). Só as ações e os corpos são documentados: o
    aviso de membro público sem comentário (CS1591) fica de fora.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Guias de uso de cada API do Swagger (sistema/DocumentacaoApi.cs) -->
    <EmbeddedResource Include="sistema/guias/*.md" LogicalName="guias/%(Filename)%(Extension)" />
    <EmbeddedResource Include="sistema/exemplos/*.json" LogicalName="exemplos/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../core/commons/Boaz.Core.Commons.csproj" />
    <ProjectReference Include="../core/landing_page/Boaz.Core.LandingPage.csproj" />
    <ProjectReference Include="../core/hub/Boaz.Core.Hub.csproj" />
    <ProjectReference Include="../core/quest/Boaz.Core.Quest.csproj" />
  </ItemGroup>
</Project>
