<Project>
  <!--
    Propriedades comuns aos projetos do mobile (14_estrutura-projetos). O SDK
    .NET e os workloads são os do global.json da raiz.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    TFMs (14_estrutura-projetos RNF-187): os apps de apps/ usam
    <TargetFrameworks>$(MobileAppTargetFrameworks)</TargetFrameworks> e as
    bibliotecas de core/ usam $(MobileCoreTargetFrameworks), que soma o
    net10.0 para os testes de tests/. O net10.0-ios só entra no macOS: no
    Linux (job android do CI) a restauração não pede o workload do iOS.
    MobileSemIos=true (variável de ambiente) deixa o macOS igual ao Linux; é
    o que a verificação Android do CI local usa.
  -->
  <PropertyGroup>
    <MobileAppTargetFrameworks>net10.0-android</MobileAppTargetFrameworks>
    <MobileAppTargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) And '$(MobileSemIos)' != 'true'">$(MobileAppTargetFrameworks);net10.0-ios</MobileAppTargetFrameworks>
    <MobileCoreTargetFrameworks>net10.0;$(MobileAppTargetFrameworks)</MobileCoreTargetFrameworks>
  </PropertyGroup>

  <!-- Versões mínimas dos sistemas (as do modelo do .NET MAUI) -->
  <PropertyGroup>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Endereço do backend (14_estrutura-projetos RNF-198): entra no build pela
    propriedade ApiUrl (dotnet build -p:ApiUrl=https://…) e fica no assembly
    como AssemblyMetadata("ApiUrl"), que o app lê na inicialização. O qa
    funcional do mobile compila com o API_URL_DISPOSITIVO; homologação e
    produção, com o endereço do ambiente.
  -->
  <ItemGroup Condition="'$(ApiUrl)' != ''">
    <AssemblyMetadata Include="ApiUrl" Value="$(ApiUrl)" />
  </ItemGroup>

  <!--
    iOS (RNF-170): o workload iOS fixado no global.json (workloadVersion
    10.0.111.1 → .NET para iOS 26.5) compila contra o SDK iOS 26.5, que é o
    SDK do Xcode de .xcode-version (26.6). Não há workload publicado para o
    Xcode 26.6, e a checagem do .NET compara o número do Xcode, não o do SDK;
    por isso ela fica desligada. Ao trocar o workloadVersion por um que case
    com o Xcode de .xcode-version, remova esta propriedade.
  -->
  <PropertyGroup>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>

  <!--
    iOS no macOS: com o repositório numa pasta do iCloud Drive (~/Documents,
    ~/Desktop), a sincronização grava atributos estendidos nas pastas do .app
    (com.apple.FinderInfo) e o codesign recusa o pacote ("resource fork,
    Finder information, or similar detritus not allowed"). Os atributos saem
    do pacote logo antes da assinatura; fora do iCloud, não muda nada.
  -->
  <Target Name="BoazLimparAtributosDoApp"
          BeforeTargets="_CodesignAppBundle"
          Condition="'$(AppBundleDir)' != '' And $([MSBuild]::IsOSPlatform('osx'))">
    <Exec Command="xattr -cr &quot;$(AppBundleDir)&quot;" />
  </Target>
</Project>
