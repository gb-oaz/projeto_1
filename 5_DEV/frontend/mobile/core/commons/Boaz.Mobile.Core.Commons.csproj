<Project Sdk="Microsoft.NET.Sdk">
  <!-- O que os contextos compartilham: componentes comuns e o design system em Resources/Styles/Design/ (RNF-184) -->
  <PropertyGroup>
    <TargetFrameworks>$(MobileCoreTargetFrameworks)</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>
</Project>
